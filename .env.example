# SOLANA RPC & NETWORKS
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_RPC_DEVNET=https://api.devnet.solana.com
PREFERRED_RPC=mainnet

# JITO CONFIGURATION
JITO_ENDPOINT=grpc://mainnet.block-engine.jito.wtf:1004
JITO_AUTH_KEYPAIR=./keys/jito-keypair.json
JITO_TIP_AMOUNT=0.01
JITO_TIP_RANGE_MIN=0.01
JITO_TIP_RANGE_MAX=0.1

# WALLET MANAGEMENT
MAIN_WALLET_KEYPAIR=./keys/main-wallet.json
MAIN_WALLET_PUBKEY=YOUR_MAIN_WALLET_ADDRESS
VAULT_ENCRYPTION_KEY=your-256-bit-hex-encryption-key-here
WALLET_CREATION_BATCH_SIZE=5

# TOKEN DEPLOYMENT (PUMP.FUN)
PUMP_FUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCMsESSeedd4 Към
PUMP_FUN_API_KEY=your-pump-fun-api-key
TOKEN_METADATA_UPLOAD_SERVICE=ipfs
IPFS_API_ENDPOINT=https://api.pinata.cloud
IPFS_API_KEY=your-pinata-api-key
IPFS_SECRET_KEY=your-pinata-secret-key

# IMAGE GENERATION
IMAGE_GENERATOR_SERVICE=dall-e
DALLE_API_KEY=your-dalle-api-key
STABLE_DIFFUSION_API_KEY=your-stable-diffusion-key

# ARWEAVE BACKUP
ARWEAVE_WALLET_PATH=./keys/arweave-wallet.json
ARWEAVE_ENABLE_BACKUP=true

# SNIPING CONFIGURATION
SNIPE_BUY_AMOUNT_SOL=0.1
SNIPE_SLIPPAGE_BPS=9900
SNIPE_PRIORITY_FEE_LAMPORTS=100000
SNIPE_WALLET_COUNT=3
SNIPE_CONCURRENT_TRANSACTIONS=5
SNIPE_MEMPOOL_MONITOR_ENABLED=true

# SELL STRATEGY
SELL_STRATEGY=mixed
SELL_TAKE_PROFIT_PERCENT=100
SELL_STOP_LOSS_PERCENT=20
SELL_TIME_DELAY_MINUTES=60
SELL_DRIP_PERCENT_PER_BATCH=25
SELL_DRIP_INTERVAL_SECONDS=30

# EXTERNAL AUTOMATION
TWITTER_ENABLED=true
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

WEBSITE_DEPLOYER_ENABLED=false
LOVABLE_API_KEY=your-lovable-api-key

DEXSCREENER_ENABLED=true
DEXSCREENER_API_KEY=your-dexscreener-api-key

# DATABASE & LOGGING
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info
LOG_FILE_PATH=./logs/bot.log
ENABLE_TRANSACTION_LOGGING=true

# SECURITY
ENABLE_ENCRYPTION=true
ENABLE_2FA=false
API_KEY_VALIDATION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# MONITORING & ALERTS
PNL_TRACKING_ENABLED=true
ALERT_ON_ERROR=true
ALERT_ON_HIGH_SLIPPAGE=true
SLIPPAGE_ALERT_THRESHOLD_BPS=5000

# VPS & DEPLOYMENT
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
ENABLE_HEADLESS_MODE=true
